# Server external port on your VPS (default is 3005 since 3000-3002 are in use)
PORT=3005

# Public URL used to access the application
APP_URL=http://89.116.26.24:3005

# Cookie security: keep false when accessing over plain HTTP (e.g. IP:PORT)
# Set to true only if you set up a reverse proxy with HTTPS (SSL certificate)
COOKIE_SECURE=false

# Optional: Gemini API key for AI features
GEMINI_API_KEY=
